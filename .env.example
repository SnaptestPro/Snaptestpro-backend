# ---- SERVER ----
PORT=3000
NODE_ENV=development
# Backend ka public URL (file upload ke links isse bante hain)
BASE_URL=http://localhost:3000

# ---- DATABASE (PostgreSQL) ----
# Neon / Supabase ka connection string yaha paste karo
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/snaptestpro

# ---- SECURITY ----
# Banane ke liye:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# In emails ko signup par admin role mil jata hai (comma se alag karo)
ADMIN_EMAILS=you@example.com
# Frontend ke domains jo backend use kar sakte hain (comma se alag)
CORS_ORIGINS=http://localhost:8000,https://YOURNAME.github.io

# ---- FILE UPLOAD ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---- HYBRID MODE (Firebase login + kuch collections yaha) ----
# Firebase Console > Project settings > General > "Project ID"
FIREBASE_PROJECT_ID=the-vishnu-sharma-test
# firestore.rules ke isOwner() wali email (comma se alag)
OWNER_EMAILS=vishnu1234stm@gmail.com
# firestore.rules me hardcoded admin email list (comma se alag)
EXTRA_ADMIN_EMAILS=vishnu1234stmp@gmail.com
# Sirf tab true karo jab Firestore par App Check ENFORCE ho (HYBRID.md "Problem aaye to" dekho)
TRUST_SNAPROLE=false
# APK ke liye https://localhost bhi daalo
# CORS_ORIGINS=https://snaptestpro.github.io,https://localhost,capacitor://localhost

# Purane admin app band karne ke liye: app ka kam se kam build number (khali/0 = band). Example: MIN_BUILD=247
# MIN_BUILD=0
