# ============================================
# 🔐 ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ============================================

# 🔌 SERVER
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# 🗄️ DATABASE (PostgreSQL)
# Local PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/snaptestpro

# Neon (Recommended - FREE):
# https://neon.tech
# DATABASE_URL=postgresql://[user]:[password]@[neon-host]:5432/snaptestpro

# ElephantSQL (FREE):
# https://www.elephantsql.com
# DATABASE_URL=postgresql://[user]:[password]@[host]:5432/[database]

# Supabase (FREE):
# https://supabase.com
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

DATABASE_URL=postgresql://user:password@localhost:5432/snaptestpro

# 🔐 SECURITY
# Generate a strong secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-key-change-this-value-NOW-use-strong-random-string

# 📧 EMAIL (Optional - for email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@snaptestpro.com

# 💾 FILE STORAGE (Optional - for cloud storage)
# Local storage (default):
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# AWS S3 (Optional):
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=snaptestpro-uploads

# 🔗 FRONTEND
FRONTEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://localhost:3000,https://snaptestpro.github.io

# 📊 LOGGING
LOG_LEVEL=debug
DEBUG=*

# 🌍 SERVICES (Optional)
GOOGLE_API_KEY=your-google-api-key
STRIPE_SECRET_KEY=your-stripe-secret-key

# 🔔 NOTIFICATIONS
NOTIFICATION_EMAIL=admin@snaptestpro.com
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================
# IMPORTANT:
# 1. Never commit .env file to GitHub
# 2. .env is already in .gitignore
# 3. Set strong JWT_SECRET (use: openssl rand -hex 32)
# 4. Keep database credentials secure
# 5. Use different .env for production
# ============================================
